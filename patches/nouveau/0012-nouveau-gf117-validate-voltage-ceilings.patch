Subject: [PATCH] Apply all VBIOS voltage ceilings before GF117 VID writes

--- a/drivers/gpu/drm/nouveau/include/nvkm/subdev/volt.h
+++ b/drivers/gpu/drm/nouveau/include/nvkm/subdev/volt.h
@@ -33,6 +33,9 @@
 int nvkm_volt_map(struct nvkm_volt *volt, u8 id, u8 temperature);
 int nvkm_volt_map_min(struct nvkm_volt *volt, u8 id);
 int nvkm_volt_get(struct nvkm_volt *);
+/* Read-only GPIO-VID preflight used by the GF117 experiment. */
+int nvkm_volt_preflight(struct nvkm_volt *, u8 id, u8 temperature,
+			int *current_uv, int *limit_uv);
 int nvkm_volt_set_id(struct nvkm_volt *, u8 id, u8 min_id, u8 temp,
 		     int condition);
 
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/volt/base.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/volt/base.c
@@ -156,6 +156,54 @@
 	return id ? id * 10000 : -ENODEV;
 }
 
+/* Only the GF117 GPIO-VID experiment calls this. Validate both the requested
+ * voltage and the rounded VID before any setter can modify the regulator. */
+int
+nvkm_volt_preflight(struct nvkm_volt *volt, u8 id, u8 temp,
+		    int *current_uv, int *limit_uv)
+{
+	u8 ids[3];
+	int target, cap, i;
+
+	if (!current_uv || !limit_uv)
+		return -EINVAL;
+	*current_uv = -ENODEV;
+	*limit_uv = 0;
+	if (!volt)
+		return -ENODEV;
+	*current_uv = nvkm_volt_get(volt);
+	if (*current_uv <= 0)
+		return *current_uv ? *current_uv : -ERANGE;
+	target = nvkm_volt_map(volt, id, temp);
+	if (target <= 0)
+		return target ? target : -ERANGE;
+	if (!volt->max_uv || volt->max_uv > INT_MAX)
+		return -ERANGE;
+	cap = volt->max_uv;
+	ids[0] = volt->max0_id;
+	ids[1] = volt->max1_id;
+	ids[2] = volt->max2_id;
+	for (i = 0; i < ARRAY_SIZE(ids); i++) {
+		if (ids[i] != 0xff) {
+			int mapped = nvkm_volt_map(volt, ids[i], temp);
+
+			if (mapped <= 0)
+				return mapped ? mapped : -ERANGE;
+			cap = min(cap, mapped);
+		}
+	}
+	*limit_uv = cap;
+	if (target > cap || *current_uv > cap)
+		return -ERANGE;
+	if (*current_uv >= target)
+		return target;
+	for (i = 0; i < volt->vid_nr; i++) {
+		if (volt->vid[i].uv >= (u32)target && volt->vid[i].uv <= (u32)cap)
+			return target;
+	}
+	return -ERANGE;
+}
+
 int
 nvkm_volt_set_id(struct nvkm_volt *volt, u8 id, u8 min_id, u8 temp,
 		 int condition)
