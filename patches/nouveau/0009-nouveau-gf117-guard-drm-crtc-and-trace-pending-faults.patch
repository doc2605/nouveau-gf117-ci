Subject: [PATCH] Guard DRM legacy CRTC and report inherited GF117 bus faults

--- a/drivers/gpu/drm/nouveau/dispnv04/hw.h
+++ b/drivers/gpu/drm/nouveau/dispnv04/hw.h
@@ -120,6 +120,10 @@
 					int head, uint8_t index, uint8_t value)
 {
 	struct nvif_object *device = &nouveau_drm(dev)->client.device.object;
+	/* GF117 has no legacy display CRTC. NVIF MMIO bypasses NVKM VGA helpers. */
+	if (nouveau_drm(dev)->client.device.info.chipset == 0xd7)
+		return;
+
 	nvif_wr08(device, NV_PRMCIO_CRX__COLOR + head * NV_PRMCIO_SIZE, index);
 	nvif_wr08(device, NV_PRMCIO_CR__COLOR + head * NV_PRMCIO_SIZE, value);
 }
@@ -129,6 +133,10 @@
 {
 	struct nvif_object *device = &nouveau_drm(dev)->client.device.object;
 	uint8_t val;
+	/* GF117 has no legacy display CRTC. NVIF MMIO bypasses NVKM VGA helpers. */
+	if (nouveau_drm(dev)->client.device.info.chipset == 0xd7)
+		return 0;
+
 	nvif_wr08(device, NV_PRMCIO_CRX__COLOR + head * NV_PRMCIO_SIZE, index);
 	val = nvif_rd08(device, NV_PRMCIO_CR__COLOR + head * NV_PRMCIO_SIZE);
 	return val;
@@ -312,7 +320,11 @@
 NVLockVgaCrtcs(struct drm_device *dev, bool lock)
 {
 	struct nouveau_drm *drm = nouveau_drm(dev);
-	bool waslocked = !NVReadVgaCrtc(dev, 0, NV_CIO_SR_LOCK_INDEX);
+	bool waslocked;
+
+	if (drm->client.device.info.chipset == 0xd7)
+		return false;
+	waslocked = !NVReadVgaCrtc(dev, 0, NV_CIO_SR_LOCK_INDEX);
 
 	NVWriteVgaCrtc(dev, 0, NV_CIO_SR_LOCK_INDEX,
 		       lock ? NV_CIO_SR_LOCK_VALUE : NV_CIO_SR_UNLOCK_RW_VALUE);
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/bus/gf100.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/bus/gf100.c
@@ -60,6 +60,18 @@
 gf100_bus_init(struct nvkm_bus *bus)
 {
 	struct nvkm_device *device = bus->subdev.device;
+	/* Preserve evidence before the normal init acknowledgement. A fault
+	 * inherited from the previous module must not look like a new access. */
+	if (device->chipset == 0xd7) {
+		u32 pending = nvkm_rd32(device, 0x001100) & 0x0000000e;
+
+		if (pending)
+			nvkm_warn(&bus->subdev,
+				  "pending MMIO fault before bus init: status=%08x addr=%08x data=%08x\n",
+				  pending, nvkm_rd32(device, 0x009084),
+				  nvkm_rd32(device, 0x009088));
+	}
+
 	nvkm_wr32(device, 0x001100, 0xffffffff);
 	nvkm_wr32(device, 0x001140, 0x0000000e);
 }
