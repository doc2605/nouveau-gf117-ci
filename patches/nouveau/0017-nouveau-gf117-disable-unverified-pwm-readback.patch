From: Codex <codex@openai.com>
Subject: [PATCH] nouveau: disable unverified GF117 PWM voltage readback

The physical diagnostic on GF117 reports zero at the borrowed GK104 PWM
register pair 0x20340/0x20344. These registers are not validated for GF117,
so interpreting their contents as regulator voltage is unsupported. Leave
the voltage subdevice absent for a PWM VBIOS instead of exposing a guessed
readback or falling back to GPIO VID. Reclocking preflight must fail closed.

--- a/drivers/gpu/drm/nouveau/nvkm/subdev/volt/gf117.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/volt/gf117.c
@@ -34,24 +34,6 @@
 };
 
 static int
-gf117_volt_pwm_get(struct nvkm_volt *base)
-{
-	struct gf117_volt *volt = container_of(base, struct gf117_volt, base);
-	struct nvkm_device *device = base->subdev.device;
-	u32 div = nvkm_rd32(device, 0x20340);
-	u32 duty = nvkm_rd32(device, 0x20344) & 0x7fffffff;
-	u64 uv;
-
-	/* This mode is read-only until GF117 PWM programming is validated. */
-	if (!div || duty > div)
-		return -ERANGE;
-	uv = volt->bios.base + div64_u64((u64)volt->bios.pwm_range * duty, div);
-	if (uv < base->min_uv || uv > base->max_uv || uv > INT_MAX)
-		return -ERANGE;
-	return (int)uv;
-}
-
-static int
 gf117_volt_speedo_read(struct nvkm_volt *volt)
 {
 	struct nvkm_device *device = volt->subdev.device;
@@ -68,10 +50,6 @@
 	.vid_get = nvkm_voltgpio_get,
 	.vid_set = nvkm_voltgpio_set,
 	.speedo_read = gf117_volt_speedo_read,
-}, gf117_volt_pwm = {
-	.oneinit = gf100_volt_oneinit,
-	.volt_get = gf117_volt_pwm_get,
-	.speedo_read = gf117_volt_speedo_read,
 };
 
 int
@@ -81,25 +59,16 @@
 	const struct nvkm_volt_func *func = &gf117_volt_gpio;
 	struct gf117_volt *volt;
 	struct nvbios_volt bios;
-	struct dcb_gpio_func gpio;
 	u8 ver, hdr, cnt, len;
-	bool pwm = false;
 	int ret = 0;
 	*pvolt = NULL;
 
 	if (device->bios &&
 	    nvbios_volt_parse(device->bios, &ver, &hdr, &cnt, &len, &bios) &&
 	    bios.type == NVBIOS_VOLT_PWM) {
-		if (bios.base && bios.pwm_range && bios.pwm_freq &&
-		    bios.base <= INT_MAX && bios.pwm_range <= INT_MAX - bios.base &&
-		    device->gpio &&
-		    !nvkm_gpio_find(device->gpio, 0, DCB_GPIO_VID_PWM, 0xff, &gpio)) {
-			func = &gf117_volt_pwm;
-			pwm = true;
-		} else {
-			/* The BIOS asks for PWM; GPIO VID would report a false voltage. */
-			return 0;
-		}
+		/* GF117 PWM register layout/readback is unverified. Do not mistake
+		 * GPIO VID or another chipset's PWM registers for voltage. */
+		return 0;
 	}
 
 	volt = kzalloc_obj(*volt);
@@ -107,12 +76,7 @@
 		return -ENOMEM;
 	nvkm_volt_ctor(func, device, type, inst, &volt->base);
 	*pvolt = &volt->base;
-	if (pwm) {
-		volt->bios = bios;
-		nvkm_info(&volt->base.subdev, "GF117 VBIOS PWM voltage readback enabled (read-only)\n");
-	} else {
-		ret = nvkm_voltgpio_init(&volt->base);
-	}
+	ret = nvkm_voltgpio_init(&volt->base);
 
 	return ret;
 }
