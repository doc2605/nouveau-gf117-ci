 	struct nvkm_therm *therm = device->therm;
 	struct nvkm_volt *volt = device->volt;
 	struct nvkm_cstate *cstate;
-	int ret;
-
-	if (!list_empty(&pstate->list)) {
+	bool core_only = nvkm_clk_fermi_core_only(clk);
+	int ret, target_uv = 0;
+
+	if (!core_only && !list_empty(&pstate->list)) {
 		cstate = nvkm_cstate_get(clk, pstate, cstatei);
 		cstate = nvkm_cstate_find_best(clk, pstate, cstate);
 		if (!cstate)
@@ -176,6 +187,15 @@
 		cstate = &pstate->base;
 	}
 
+	if (core_only) {
+		/* A missing/unreadable regulator must not be treated as success. */
+		if (!volt || nvkm_volt_get(volt) <= 0)
+			return -ENODEV;
+		target_uv = nvkm_volt_map(volt, cstate->voltage, clk->temp);
+		if (target_uv <= 0)
+			return target_uv ? target_uv : -ERANGE;
+	}
+
 	if (therm) {
 		ret = nvkm_therm_cstate(therm, pstate->fanspeed, +1);
 		if (ret && ret != -ENODEV) {
@@ -187,17 +207,25 @@
 	if (volt) {
 		ret = nvkm_volt_set_id(volt, cstate->voltage,
 				       pstate->base.voltage, clk->temp, +1);
-		if (ret && ret != -ENODEV) {
+		if (ret && (core_only || ret != -ENODEV)) {
 			nvkm_error(subdev, "failed to raise voltage: %d\n", ret);
 			return ret;
 		}
 	}
+
+	if (core_only && nvkm_volt_get(volt) < target_uv)
+		return -ERANGE;
 
 	ret = clk->func->calc(clk, cstate);
 	if (ret == 0) {
 		ret = clk->func->prog(clk);
 		clk->func->tidy(clk);
 	}
+
+	/* Core-only mode never lowers boot voltage or cooling. In particular,
+	 * keep voltage raised if a PLL switch fails; physical state is unknown. */
+	if (core_only)
+		return ret;
 
 	if (volt) {
 		int err = nvkm_volt_set_id(volt, cstate->voltage,
@@ -278,6 +306,37 @@
 	list_for_each_entry(pstate, &clk->states, head) {
 		if (idx++ == pstatei)
 			break;
+	}
+
+	if (nvkm_clk_fermi_core_only(clk)) {
+		struct nvkm_cstate plan;
+		int memory_before, memory_after, core_after;
+
+		/* Use the VBIOS state and existing core/voltage path only. No PCIe,
+		 * RAMFUC, memory PLL, memory timing or synthetic pstate writes. */
+		memory_before = nvkm_clk_read(clk, nv_clk_src_mem);
+		if (memory_before <= 0)
+			return -ENODEV;
+		ret = nvkm_clk_dryrun(clk, pstatei, &plan);
+		if (ret)
+			return ret;
+		if (!plan.domain[nv_clk_src_gpc])
+			return -ERANGE;
+		ret = nvkm_cstate_prog(clk, pstate, NVKM_CLK_CSTATE_HIGHEST);
+		if (ret) {
+			clk->pstate = -1;
+			return ret;
+		}
+		memory_after = nvkm_clk_read(clk, nv_clk_src_mem);
+		core_after = nvkm_clk_read(clk, nv_clk_src_gpc);
+		if (memory_after != memory_before || core_after <= 0 ||
+		    abs((s64)core_after - plan.domain[nv_clk_src_gpc]) >
+			plan.domain[nv_clk_src_gpc] / 100) {
+			clk->pstate = -1;
+			return -EIO;
+		}
+		clk->pstate = pstatei;
+		return 0;
 	}
 
 	/* The experimental GF117 opt-in must not continue to core/voltage
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gf100.c
