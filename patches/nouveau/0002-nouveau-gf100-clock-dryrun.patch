+static int
+nouveau_debugfs_pstate_plan_get(struct seq_file *m, void *data)
+{
+	struct drm_device *drm = m->private;
+	struct nouveau_drm *ndrm = nouveau_drm(drm);
+	struct nvkm_clk *clk = nvxx_clk(ndrm);
+	struct nvkm_fb *fb = nvxx_fb(ndrm);
+	struct nvkm_pstate *pstate;
+	int i = 0;
+
+	if (!clk)
+		return -ENODEV;
+
+	seq_printf(m, "allow_reclock=%u states=%d current=%d\n",
+		   clk->allow_reclock, clk->state_nr, clk->pstate);
+	list_for_each_entry(pstate, &clk->states, head) {
+		struct nvkm_cstate cstate;
+		struct nvkm_ram_dryrun ram;
+		u32 requested_core = pstate->base.domain[nv_clk_src_gpc];
+		u32 requested_memory = pstate->base.domain[nv_clk_src_mem];
+		int state = i++;
+		int ret = nvkm_clk_dryrun(clk, state, &cstate);
+		int ram_ret;
+
+		if (ret) {
+			seq_printf(m, "state=%d dryrun_error=%d\n", state, ret);
+			continue;
+		}
+
+		ram_ret = fb && fb->ram ? nvkm_ram_dryrun(fb->ram, requested_memory,
+							 &ram) : -ENODEV;
+		seq_printf(m, "state=%d id=%u voltage=%u requested_core=%u "
+			   "calculated_core=%u requested_memory=%u\n", state, cstate.id,
+			   cstate.voltage,
+			   requested_core,
+			   cstate.domain[nv_clk_src_gpc],
+			   requested_memory);
+		if (ram_ret)
+			seq_printf(m, "state=%d ram_dryrun_error=%d\n", state, ram_ret);
+		else
+			seq_printf(m, "state=%d rammap_ver=%u strap=%u timing_ver=%u "
+				   "timing_present=%u ref_khz=%u rounded_memory=%u\n",
+				   state, ram.rammap_ver, ram.ramcfg_strap,
+				   ram.timing_ver, ram.timing_present, ram.ref_khz,
+				   ram.rounded_khz);
+	}
+	return 0;
+}
+
+static int
+nouveau_debugfs_pstate_plan_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, nouveau_debugfs_pstate_plan_get,
+			   inode->i_private);
+}
