 int
+gf100_ram_dryrun(struct nvkm_ram *base, u32 freq,
+		 struct nvkm_ram_dryrun *out)
+{
+	struct gf100_ram *ram = gf100_ram(base);
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_bios *bios = device->bios;
+	struct nvkm_clk *clk = device->clk;
+	struct nvbios_ramcfg cfg;
+	u8 ver, cnt, len, strap;
+	struct { u32 data; u8 size; } rammap, ramcfg, timing;
+	int ref;
+	u32 div, out_freq;
+	u64 doubled_ref, quotient;
+
+	if (!out || !freq)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	out->requested_khz = freq;
+
+	/* This is the lookup portion of gf100_ram_calc(), deliberately stopping
+	 * before ram_init(), RAMFUC construction, PLL programming or any writes. */
+	rammap.data = nvbios_rammapEm(bios, freq / 1000, &ver, &rammap.size,
+				      &cnt, &ramcfg.size, &cfg);
+	if (!rammap.data || ver != 0x10 || rammap.size < 0x0e)
+		return -EINVAL;
+	out->rammap_ver = ver;
+
+	strap = nvbios_ramcfg_index(subdev);
+	if (strap >= cnt)
+		return -EINVAL;
+	out->ramcfg_strap = strap;
+	ramcfg.data = rammap.data + rammap.size + (strap * ramcfg.size);
+	if (!ramcfg.data || ramcfg.size < 0x0e)
+		return -EINVAL;
+
+	strap = nvbios_rd08(bios, ramcfg.data + 0x01);
+	if (strap != 0xff) {
+		timing.data = nvbios_timingEe(bios, strap, &ver, &timing.size,
+					      &cnt, &len);
+		if (!timing.data || ver != 0x10 || timing.size < 0x19)
+			return -EINVAL;
+		out->timing_present = true;
+		out->timing_ver = ver;
+	}
+
+	if (!clk)
+		return -ENODEV;
+	if (!(nvkm_rd32(device, 0x137300) & 0x00000100))
+		ref = nvkm_clk_read(clk, nv_clk_src_sppll0);
+	else
+		ref = nvkm_clk_read(clk, nv_clk_src_sppll1);
+	if (ref <= 0)
+		return ref ? ref : -ERANGE;
+	/* Keep the arithmetic wide: ref is an int from nvkm_clk_read(), while
+	 * freq is u32.  The original programming path assumes normal MHz values;
+	 * the dry-run must reject pathological input instead of overflowing. */
+	doubled_ref = (u64)(u32)ref * 2;
+	quotient = doubled_ref / freq;
+	quotient = min(quotient, (u64)65);
+	quotient = max(quotient, (u64)2);
+	div = (u32)quotient - 2;
+	quotient = doubled_ref / (div + 2);
+	if (quotient > U32_MAX)
+		return -ERANGE;
+	out_freq = (u32)quotient;
+	out->ref_khz = ref;
+	out->rounded_khz = out_freq;
+	return 0;
+}
