diff --git a/drivers/gpu/drm/nouveau/nouveau_debugfs.c b/drivers/gpu/drm/nouveau/nouveau_debugfs.c
index 47d5579..a399113 100644
--- a/drivers/gpu/drm/nouveau/nouveau_debugfs.c
+++ b/drivers/gpu/drm/nouveau/nouveau_debugfs.c
@@ -138,6 +138,47 @@ nouveau_debugfs_pstate_get(struct seq_file *m, void *data)
 	return 0;
 }
 
+static int
+nouveau_debugfs_pstate_current_get(struct seq_file *m, void *data)
+{
+	struct drm_device *drm = m->private;
+	struct nouveau_debugfs *debugfs = nouveau_debugfs(drm);
+	struct nvif_control_pstate_attr_v0 attr = {
+		.state = NVIF_CONTROL_PSTATE_ATTR_V0_STATE_CURRENT,
+		.index = 0,
+	};
+	int ret;
+
+	if (!debugfs)
+		return -ENODEV;
+
+	do {
+		ret = nvif_mthd(&debugfs->ctrl, NVIF_CONTROL_PSTATE_ATTR,
+				&attr, sizeof(attr));
+		if (ret)
+			return ret;
+
+		seq_printf(m, "%s %d %s\n", attr.name, attr.min, attr.unit);
+	} while (attr.index);
+
+	return 0;
+}
+
+static int
+nouveau_debugfs_pstate_current_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, nouveau_debugfs_pstate_current_get,
+			   inode->i_private);
+}
+
+static const struct file_operations nouveau_pstate_current_fops = {
+	.owner = THIS_MODULE,
+	.open = nouveau_debugfs_pstate_current_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 static ssize_t
 nouveau_debugfs_pstate_set(struct file *file, const char __user *ubuf,
 			   size_t len, loff_t *offp)
@@ -261,6 +302,7 @@ static const struct nouveau_debugfs_files {
 	const struct file_operations *fops;
 } nouveau_debugfs_files[] = {
 	{"pstate", &nouveau_pstate_fops},
+	{"pstate_current", &nouveau_pstate_current_fops},
 };
 
 void
